PORT=4173
# Enable Bothost persistent storage and require an access password.
BOTHOST=1
APP_PASSWORD=replace-with-a-long-random-password
# Password for the Начальство role. If empty, APP_PASSWORD is used as fallback.
MANAGER_PASSWORD=replace-with-manager-password
# Password for the Менеджер role. If empty, APP_PASSWORD is used as fallback.
OWNER_PASSWORD=replace-with-owner-password
# Telegram bot token from @BotFather. Leave empty to run without notifications.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram chat ID of the manager, after they start the bot.
MANAGER_CHAT_ID=
# Telegram user ID allowed to create and edit tasks (use the bot's /id command).
OWNER_TELEGRAM_ID=
# HTTPS URL opened as the Telegram Mini App.
WEBAPP_URL=https://bot-1793823483-4147-exel.bothost.tech/
